APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
 localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# Login OTP: email now, sms later when provider is ready
LOGIN_OTP_CHANNEL=email

# Google OAuth (must match Google Cloud Console redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/login/google/callback"


AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Member chat realtime: "reverb" (own server, see below) or "pusher" (hosted). Without either, chat still works by auto-refresh.
CHAT_REALTIME=reverb
# Reverb: make up your own id / key / secret (any random strings). HOST+PORT+SCHEME = the PUBLIC address browsers connect to (wss).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=chat.yourdomain.com
REVERB_PORT=443
REVERB_SCHEME=https
# Where the Reverb process itself listens on the server (the web server proxies the public address to this)
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"



GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Appointment calendar invites (.ics emailed on Confirm & Schedule)
APPOINTMENT_TIMEZONE=Asia/Karachi
APPOINTMENT_DURATION_MINUTES=30

# Team proposal form "Extract with AI" (never commit the real key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
